# 复制为 E:\CDC-Food\shared\config\server.env，再逐项填写。
# 本文件不含任何真实密钥；不要把实际 server.env 提交到 Git。
APP_ENV=production
APP_NAME=cdc-food-server
APP_HOST=127.0.0.1
APP_PORT=18120
APP_LOG_DIR=E:/CDC-Food/shared/logs
LOG_LEVEL=INFO

# 至少 32 位随机值，例如用密码管理器生成。禁止沿用示例文本。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 用户名、密码与数据库名均需 URL 编码；只能连接隔离的 55432 端口。
DATABASE_URL=postgresql+asyncpg://cdc_food_app:<URL_ENCODED_PASSWORD>@127.0.0.1:55432/cdc_food

# 密钥只保存在服务器端 server.env，不得写入小程序或仓库。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus
WECHAT_APPID=
WECHAT_SECRET=

# 首次创建管理员时临时填写；创建并改密后删除这两行并重启服务。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Windows 自建服务器的持久化私有目录，不经 Nginx 静态暴露。
MEDIA_STORAGE_BACKEND=local_persistent
MEDIA_STORAGE_DIR=E:/CDC-Food/shared/uploads
MEDIA_URL_TTL_SECONDS=900

DAILY_ANALYSIS_LIMIT_PER_USER=20
IMAGE_MAX_BYTES=1048576
