# 仅将本段人工合并到 1tovalue.cn 现有 HTTPS server{} 中。
# 不要覆盖现有 nginx.conf；合并后先运行 E:\nginx\nginx-1.28.0\nginx.exe -t。
# proxy_pass 末尾的 / 会移除 /cdc-food-api/ 前缀：
# /cdc-food-api/api/v1/... -> http://127.0.0.1:18120/api/v1/...

location = /cdc-food-api {
    return 308 /cdc-food-api/;
}

location /cdc-food-api/ {
    proxy_pass http://127.0.0.1:18120/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /cdc-food-api;

    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    client_max_body_size 9m;
    proxy_request_buffering on;
}

