/* components/section/section.wxss */
.section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 16rpx;
}
.section .title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
}
.section .more {
  color: var(--brand, #0F8A65);
  font-size: 26rpx;
  font-weight: 500;
}
