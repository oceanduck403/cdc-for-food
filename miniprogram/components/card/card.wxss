.card {
  background: var(--bg-white, #FFFFFF);
  border-radius: var(--radius-lg, 24rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 4rpx rgba(15,138,101,0.06));
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(15, 138, 101, 0.06);
  overflow: hidden;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  line-height: 1.35;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 25rpx;
  color: var(--text-secondary, #4B5563);
  line-height: 1.5;
}
