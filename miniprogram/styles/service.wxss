/* Main service pages: readable type, clear hierarchy and consistent touch targets. */
.container.service-page { box-sizing: border-box; padding: 28rpx 28rpx 48rpx; background: #F5F9FC; }
.service-page .page-header { position: relative; padding: 36rpx 32rpx; margin-bottom: 32rpx; border-radius: 28rpx; background: linear-gradient(120deg, #0E4D7C, #1769A6); overflow: hidden; }
.service-page .page-header::after { content: ''; position: absolute; width: 210rpx; height: 210rpx; border: 38rpx solid rgba(255,255,255,.045); border-radius: 50%; right: -100rpx; top: -82rpx; pointer-events: none; }
.service-page .hero-emblem { position: absolute; top: 52rpx; right: 42rpx; z-index: 1; display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; border: 2rpx solid rgba(255,255,255,.4); border-radius: 28rpx; background: linear-gradient(145deg,rgba(255,255,255,.24),rgba(255,255,255,.08)); box-shadow: 0 16rpx 32rpx rgba(4,46,82,.25), inset 0 3rpx 5rpx rgba(255,255,255,.35); transform: rotate(-8deg); }
.service-page .hero-emblem::after { content: ''; position: absolute; z-index: -1; width: 118rpx; height: 38rpx; left: 4rpx; top: 102rpx; border-radius: 50%; background: rgba(3,43,76,.22); filter: blur(12rpx); }
.service-page .page-header .hero-eyebrow, .service-page .page-header .page-title, .service-page .page-header .page-desc { position: relative; z-index: 2; padding-right: 124rpx; }
.service-page .hero-eyebrow { display: block; font-size: 29rpx; letter-spacing: 1rpx; color: #E2F1FA; margin-bottom: 18rpx; }
.service-page .page-title { color: white; font-size: 46rpx; line-height: 1.25; font-weight: 600; letter-spacing: 2rpx; margin: 0; }
.service-page .page-desc { font-size: 30rpx; line-height: 1.6; color: #EDF6FC; margin-top: 16rpx; }
.service-page .card { border: 1rpx solid #D7E4EF; border-radius: 24rpx; box-shadow: 0 6rpx 18rpx rgba(23,105,166,.05); }
.service-page .section-title { color: #183B58; font-size: 34rpx; }
.service-page .service-note { display: block; font-size: 30rpx; line-height: 1.65; color: #405A70; margin: 14rpx 0 24rpx; }
.service-page .btn-doctor { width: 100%; border-radius: 16rpx; background: #1769A6; color: white; font-size: 32rpx; font-weight: 600; min-height: 96rpx; line-height: 96rpx; padding: 0 20rpx; box-sizing: border-box; }
.service-page .btn-doctor:active { background: #0E4D7C; transform: scale(0.985); }
.service-page .state-card { padding: 42rpx 28rpx; text-align: center; background: white; border: 1rpx solid #D7E4EF; border-radius: 20rpx; color: #506A80; font-size: 30rpx; line-height: 1.7; }
.service-page .state-card button { margin-top: 20rpx; color: #1769A6; }
.service-page .ai-content { font-size: 30rpx; line-height: 1.8; }
.service-page .service-icon { width: 60rpx; height: 60rpx; flex-shrink: 0; margin-right: 20rpx; }
.service-page .small-line-icon { width: 40rpx; height: 40rpx; margin-right: 16rpx; }
.service-page .profile-line-icon { width: 86rpx; height: 86rpx; }
.service-page .habit-icon { width: 62rpx; height: 62rpx; }
.service-page .empty-line-icon { width: 90rpx; height: 90rpx; margin-bottom: 24rpx; }
.service-page .section-heading-row { display: flex; justify-content: space-between; align-items: center; margin: 34rpx 0 20rpx; }
.service-page .section-heading-row .section-title { margin: 0; font-size: 34rpx; }
.service-page .section-count { color: #506A80; font-size: 29rpx; }
.service-page .survey-card { align-items: flex-start; padding: 28rpx 24rpx; margin-bottom: 20rpx; position: relative; }
.service-page .survey-icon { width: 76rpx; height: 76rpx; margin-right: 22rpx; border-radius: 20rpx; flex-shrink: 0; background: #EAF4FB !important; }
.service-page .survey-line-icon { width: 54rpx; height: 54rpx; }
.service-page .survey-info { flex: 1; min-width: 0; padding-bottom: 42rpx; }
.service-page .survey-title { font-size: 32rpx; line-height: 1.5; color: #183B58; font-weight: 600; margin-bottom: 10rpx; }
.service-page .survey-desc { color: #405A70; font-size: 30rpx; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.service-page .survey-meta { color: #506A80; font-size: 29rpx; margin-top: 18rpx; }
.service-page .survey-status { position: absolute; right: 24rpx; bottom: 23rpx; display: flex; flex-direction: row; gap: 12rpx; align-items: center; }
.service-page .status-tag { font-size: 28rpx; padding: 6rpx 14rpx; border-radius: 8rpx; color: #405A70; background: #EAF4FB; }
.service-page .status-tag.completed { background: #E5F4EB; color: #176448; }
.service-page .survey-arrow { color: #1769A6; font-size: 34rpx; margin: 0; }
.service-page .checkin-item { background: #F5F9FC; border: 1rpx solid #D7E4EF; border-radius: 20rpx; padding: 26rpx 8rpx; }
.service-page .checkin-item.done { background: #E5F4EB; border-color: #A7D4BD; }
.service-page .checkin-icon { display: flex; align-items: center; justify-content: center; margin-bottom: 18rpx; }
.service-page .checkin-label { font-size: 30rpx; color: #183B58; font-weight: 500; }
.service-page .checkin-status { color: #506A80; font-size: 29rpx; }
.service-page .stats-card .stat-num { color: #1769A6; font-size: 46rpx; font-weight: 600; }
.service-page .stats-card .stat-label { color: #405A70; font-size: 30rpx; }
.service-page .ai-card { background: #EAF4FB; border-color: #D7E4EF; }
.service-page .ai-content { background: #F5F9FC; color: #183B58; border-radius: 20rpx; padding: 24rpx; }
.service-page .card-title { color: #183B58; font-size: 34rpx; }
.service-page .ai-ask-banner { background: #EAF4FB; border: 1rpx solid #D7E4EF; border-radius: 24rpx; }
.service-page .ai-ask-title { color: #1769A6; }
.service-page .ai-ask-desc { color: #506A80; }
.service-page .category-item { border-radius: 12rpx; background: #EAF4FB; }
.service-page .category-item.active { background: #1769A6 !important; }
.service-page .category-item:active { transform: scale(0.97); }
.service-page .knowledge-card { border: 1rpx solid #D7E4EF; border-radius: 24rpx; }
.service-page .tabs { background: #EAF4FB; padding: 8rpx; border-radius: 18rpx; }
.service-page .tab.active { background: white; color: #0E4D7C; border-radius: 12rpx; font-weight: 700; box-shadow: 0 2rpx 10rpx rgba(23,105,166,.12); }
.service-page .info-footer text { color: #506A80; font-size: 29rpx; line-height: 1.7; }
