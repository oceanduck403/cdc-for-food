/* app.wxss 全局样式 */
page {
  background-color: #F5F7FA;
  color: #1F2D3D;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #0F2A1F;
}

.subtitle {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

.btn-primary {
  background-color: #0F8A65;
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-weight: 500;
}

.btn-ghost {
  background-color: transparent;
  color: #0F8A65;
  border: 1rpx solid #0F8A65;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
}

.text-muted { color: #9CA3AF; }
.text-success { color: #0F8A65; }
.text-warning { color: #B45309; }
.text-danger  { color: #B91C1C; }