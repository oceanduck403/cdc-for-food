/* ── 全局基础样式 ─────────────────────────────────────────────────────────────── */

page {
  --brand:        #0F8A65;
  --brand-light:  #E8F5F0;
  --brand-dark:   #086A4F;
  --accent:       #F59E0B;
  --accent-light: #FEF3C7;
  --danger:       #EF4444;
  --danger-light: #FEE2E2;
  --warn:         #B45309;
  --warn-light:   #FEF3C7;
  --bg:           #F2F5F8;
  --bg-white:      #FFFFFF;
  --text-primary: #111827;
  --text-secondary:#4B5563;
  --text-muted:   #9CA3AF;
  --border:       #E5E7EB;
  --shadow-sm:     0 1rpx 4rpx rgba(15, 138, 101, 0.06);
  --shadow-md:     0 4rpx 16rpx rgba(15, 138, 101, 0.10);
  --shadow-lg:     0 8rpx 32rpx rgba(15, 138, 101, 0.14);
  --radius-sm:     12rpx;
  --radius-md:     16rpx;
  --radius-lg:     24rpx;
  --radius-xl:     32rpx;

  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

view, text { box-sizing: border-box; }

/* ── 通用布局 ─────────────────────────────────────────────────────────────── */

.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ── 卡片 ─────────────────────────────────────────────────────────────────── */

.card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(15, 138, 101, 0.06);
}

.card.card--flat {
  box-shadow: none;
  border: 1rpx solid var(--border);
}

/* ── 标题 / 文本 ──────────────────────────────────────────────────────────── */

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.title--sm {
  font-size: 30rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

.text-muted   { color: var(--text-muted); }
.text-success { color: var(--brand); }
.text-warning { color: var(--warn); }
.text-danger  { color: var(--danger); }
.text-accent  { color: var(--accent); }

/* ── 按钮 ─────────────────────────────────────────────────────────────────── */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #0F8A65, #10B981);
  color: #FFFFFF;
  border: none;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(15, 138, 101, 0.35);
  margin-top: 20rpx;
  transition: opacity 0.2s;
}
.btn-primary:active { opacity: 0.85; }
.btn-primary[disabled] {
  background: linear-gradient(135deg, #9CA3AF, #D1D5DB);
  box-shadow: none;
  opacity: 0.7;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
  transition: background 0.2s;
}
.btn-ghost:active { background: var(--brand-light); }
.btn-ghost[disabled] {
  color: var(--text-muted);
  border-color: var(--border);
  opacity: 0.7;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
}
.btn-danger:active { background: var(--danger-light); }

/* ── 分隔线 ──────────────────────────────────────────────────────────────── */

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 0;
}

/* ── 进度条 ──────────────────────────────────────────────────────────────── */

.bar {
  height: 14rpx;
  background: var(--border);
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #0F8A65, #34D399);
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

/* ── 空状态 ──────────────────────────────────────────────────────────────── */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-muted);
}
.empty-state__icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-state__text { font-size: 28rpx; }

/* ── 微信 button 原生样式覆盖 ─────────────────────────────────────────── */
button::after { border: none; }
button {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border-radius: 0;
}
