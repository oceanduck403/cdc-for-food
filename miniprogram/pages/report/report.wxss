/* pages/report/report.wxss */

/* 膳食结构进度行 */
.structure-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}
.structure-row .bar {
  flex: 1;
  height: 12rpx;
  background: var(--border, #E5E7EB);
  border-radius: 999rpx;
  overflow: hidden;
}
.structure-row .bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #0F8A65, #34D399);
  border-radius: 999rpx;
}
.structure-row .text-muted {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
  min-width: 64rpx;
  text-align: right;
}

/* 建议列表 */
.advice-item {
  padding: 10rpx 0;
  font-size: 27rpx;
  color: var(--text-secondary, #4B5563);
  line-height: 1.7;
}

/* 报告注脚 */
.footnote {
  color: var(--text-muted, #9CA3AF);
  font-size: 24rpx;
  line-height: 1.7;
}
