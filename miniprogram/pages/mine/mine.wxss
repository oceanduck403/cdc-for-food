@import "../../styles/service.wxss";
/* ── 用户卡 ─────────────────────────────────────────────────────────── */

.user-card {
  position: relative;
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.user-bg-decoration {
  position: absolute;
  top: 0; right: 0;
  width: 280rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(23,105,166,0.10), rgba(115,191,231,0.06));
  border-bottom-left-radius: 999rpx;
  pointer-events: none;
}

/* 登录状态 */
.user-info {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  position: relative;
  z-index: 1;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.avatar-guest {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg, #F2F5F8);
  border: 4rpx solid var(--border, #E5E7EB);
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-emoji { font-size: 56rpx; }

.login-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: var(--brand, #1769A6);
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-star { font-size: 28rpx; }

.user-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  line-height: 1.3;
}

.user-sub {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 6rpx;
}

.user-edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--brand-light, #EAF4FB);
  color: var(--brand, #1769A6);
  font-size: 28rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 健康摘要 */
.health-summary {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--border, #E5E7EB);
  background: rgba(23,105,166,0.04);
}

.hs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-val {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand, #1769A6);
}

.hs-label {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 4rpx;
}

.hs-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border, #E5E7EB);
}

/* 未登录 */
.guest-info {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  position: relative;
  z-index: 1;
}

.login-btn {
  width: auto;
  padding: 0 36rpx;
  height: 96rpx;
  font-size: 30rpx;
  flex-shrink: 0;
  margin-top: 0;
}

/* ── 快捷入口 ─────────────────────────────────────────────────────── */

.quick-links {
  margin-bottom: 24rpx;
}

.quick-link {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 0;
  border-radius: var(--radius-lg, 24rpx);
  border: 1rpx solid #D7E4EF;
  transition: transform 0.15s;
}

.quick-link:first-child { border-radius: var(--radius-lg, 24rpx) var(--radius-lg, 24rpx) 0 0; }
.quick-link:last-child  { border-radius: 0 0 var(--radius-lg, 24rpx) var(--radius-lg, 24rpx); border-top: none; }
.quick-link:active { transform: scale(0.98); }

.ql-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ql-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary, #111827);
}

.ql-sub {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  margin-right: 8rpx;
}

.ql-arrow {
  font-size: 36rpx;
  color: var(--border, #E5E7EB);
  font-weight: 300;
}

/* ── 设置列表 ─────────────────────────────────────────────────────── */

.settings-section {
  padding: 0;
  overflow: hidden;
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: 24rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--border, #E5E7EB);
  transition: background 0.15s;
}

.settings-row:last-child { border-bottom: none; }
.settings-row:active { background: rgba(0,0,0,0.02); }

.sr-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sr-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary, #111827);
}

.sr-ver {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  margin-right: 8rpx;
}

.account-delete-row {
  min-height: 112rpx;
}

.account-delete-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.account-delete-title {
  color: #B83232;
  font-weight: 600;
}

.account-delete-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #7B6262;
}

.sr-arrow {
  font-size: 36rpx;
  color: var(--border, #E5E7EB);
  font-weight: 300;
}

/* ── 退出登录 ─────────────────────────────────────────────────────── */

.logout-section {
  margin-bottom: 24rpx;
}

.user-name { font-size: 37rpx; color: #1b3e50; }
.user-sub, .hs-label { font-size: 28rpx; color: #526d7a; }
.user-edit-btn { padding: 15rpx 22rpx; font-size: 28rpx; color: #1769A6; background: #e8f3f9; }
.quick-link, .settings-row { min-height: 92rpx; box-sizing: border-box; border-color: #dce7ec; }
.ql-text, .sr-text { font-size: 32rpx; color: #203f4e; }
.ql-sub, .sr-ver { font-size: 28rpx; color: #586f7a; }
.ql-arrow, .sr-arrow { color: #57798b; }
.mine-pressed { opacity: .78; transform: scale(.98); }
