/* ── 用户卡 ─────────────────────────────────────────────────────────── */

.user-card {
  position: relative;
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.user-bg-decoration {
  position: absolute;
  top: 0; right: 0;
  width: 280rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(15,138,101,0.08), rgba(52,211,153,0.05));
  border-bottom-left-radius: 999rpx;
  pointer-events: none;
}

/* 登录状态 */
.user-info {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  position: relative;
  z-index: 1;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.avatar-guest {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg, #F2F5F8);
  border: 4rpx solid var(--border, #E5E7EB);
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-emoji { font-size: 56rpx; }

.login-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: var(--brand, #0F8A65);
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-star { font-size: 20rpx; }

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  line-height: 1.3;
}

.user-sub {
  font-size: 25rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 6rpx;
}

.user-edit-btn {
  background: var(--brand-light, #E8F5F0);
  color: var(--brand, #0F8A65);
  font-size: 25rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 健康摘要 */
.health-summary {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--border, #E5E7EB);
  background: rgba(15,138,101,0.03);
}

.hs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-val {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand, #0F8A65);
}

.hs-label {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 4rpx;
}

.hs-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border, #E5E7EB);
}

/* 未登录 */
.guest-info {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  position: relative;
  z-index: 1;
}

.login-btn {
  width: auto;
  padding: 0 36rpx;
  height: 76rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 0;
}

/* ── 快捷入口 ─────────────────────────────────────────────────────── */

.quick-links {
  margin-bottom: 24rpx;
}

.quick-link {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 0;
  border-radius: var(--radius-lg, 24rpx);
  border: 1rpx solid rgba(15,138,101,0.06);
  transition: transform 0.15s;
}

.quick-link:first-child { border-radius: var(--radius-lg, 24rpx) var(--radius-lg, 24rpx) 0 0; }
.quick-link:last-child  { border-radius: 0 0 var(--radius-lg, 24rpx) var(--radius-lg, 24rpx); border-top: none; }
.quick-link:active { transform: scale(0.98); }

.ql-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ql-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary, #111827);
}

.ql-sub {
  font-size: 25rpx;
  color: var(--text-muted, #9CA3AF);
  margin-right: 8rpx;
}

.ql-arrow {
  font-size: 36rpx;
  color: var(--border, #E5E7EB);
  font-weight: 300;
}

/* ── 设置列表 ─────────────────────────────────────────────────────── */

.settings-section {
  padding: 0;
  overflow: hidden;
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: 24rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--border, #E5E7EB);
  transition: background 0.15s;
}

.settings-row:last-child { border-bottom: none; }
.settings-row:active { background: rgba(0,0,0,0.02); }

.sr-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sr-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary, #111827);
}

.sr-ver {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
  margin-right: 8rpx;
}

.sr-arrow {
  font-size: 36rpx;
  color: var(--border, #E5E7EB);
  font-weight: 300;
}

/* ── 退出登录 ─────────────────────────────────────────────────────── */

.logout-section {
  margin-bottom: 24rpx;
}

/* ── 免责声明 ─────────────────────────────────────────────────────── */

.disclaimer {
  text-align: center;
  padding: 8rpx 16rpx;
}

.disclaimer text {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  line-height: 1.9;
}
