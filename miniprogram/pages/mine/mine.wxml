<view class="container service-page">

  <!-- 用户信息卡 -->
  <view class="user-card card">
    <view class="user-bg-decoration"/>
    <block wx:if="{{isLogin && profile}}">
      <view class="user-info">
        <view class="avatar-wrap" bindtap="goProfile" hover-class="mine-pressed" aria-label="更换头像">
          <image class="avatar" src="{{profile.avatarDisplayUrl || '/images/ui/user.png'}}"
                 mode="aspectFill" binderror="onAvatarError"/>
          <view class="login-badge">
            <ui-icon name="edit" tone="white" size="22" />
          </view>
        </view>
        <view class="user-meta">
          <text class="user-name">{{profile.nickname || '微信用户'}}</text>
          <text class="user-sub" wx:if="{{profile.age}}">{{profile.age}}岁 · {{profile.sexLabel || ''}}</text>
          <text class="user-sub" wx:else>已登录</text>
        </view>
        <view class="user-edit-btn" bindtap="goProfile" hover-class="mine-pressed">
          <text>编辑头像昵称</text>
        </view>
      </view>

      <!-- 健康数据摘要 -->
      <view class="health-summary" wx:if="{{profile.heightCm && profile.weightKg}}">
        <view class="hs-item">
          <text class="hs-val">{{profile.heightCm}}</text>
          <text class="hs-label">身高 cm</text>
        </view>
        <view class="hs-divider"/>
        <view class="hs-item">
          <text class="hs-val">{{profile.weightKg}}</text>
          <text class="hs-label">体重 kg</text>
        </view>
        <view class="hs-divider"/>
        <view class="hs-item">
          <text class="hs-val">{{bmi}}</text>
          <text class="hs-label">BMI</text>
        </view>
      </view>
    </block>

    <!-- 未登录 -->
    <block wx:else>
      <view class="guest-info">
        <view class="avatar-wrap avatar-guest">
          <image class="profile-line-icon" src="/images/ui/user.png" mode="aspectFit"/>
        </view>
        <view class="user-meta">
          <text class="user-name">游客</text>
          <text class="user-sub">登录后享受完整功能</text>
        </view>
        <view class="btn-primary login-btn" bindtap="goLogin" hover-class="mine-pressed">
          立即登录
        </view>
      </view>
    </block>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-links">
    <view class="quick-link card" bindtap="goProfile" hover-class="mine-pressed">
      <ui-icon class="ql-icon" name="file" size="42" />
      <text class="ql-text">健康档案</text>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
    <view class="quick-link card" bindtap="callSupport" hover-class="mine-pressed">
      <ui-icon class="ql-icon" name="phone" size="42" />
      <text class="ql-text">联系客服</text>
      <text class="ql-sub">87033314</text>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
  </view>

  <!-- 设置列表 -->
<view class="settings-section card">
    <view class="settings-row" bindtap="openPrivacy" hover-class="mine-pressed">
      <ui-icon class="sr-icon" name="file" size="38" />
      <text class="sr-text">隐私政策</text>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
    <view class="settings-row" bindtap="openTerms" hover-class="mine-pressed">
      <ui-icon class="sr-icon" name="file" size="38" />
      <text class="sr-text">用户服务条款</text>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
    <view class="settings-row" bindtap="openAbout" hover-class="mine-pressed">
      <ui-icon class="sr-icon" name="info" size="38" />
      <text class="sr-text">关于我们</text>
      <text class="sr-ver">v1.0.0</text>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
    <view class="settings-row account-delete-row" wx:if="{{isLogin}}" bindtap="onDeleteAccount" hover-class="mine-pressed">
      <ui-icon class="sr-icon" name="delete" size="38" />
      <view class="account-delete-copy">
        <text class="sr-text account-delete-title">注销账号</text>
        <text class="account-delete-note">永久删除账号及个人数据</text>
      </view>
      <ui-icon name="right" tone="muted" size="26" />
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <view class="btn-danger" bindtap="onLogout" hover-class="mine-pressed">退出登录</view>
  </view>

</view>
<ai-float />
