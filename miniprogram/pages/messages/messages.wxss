.messages-page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 28rpx calc(70rpx + env(safe-area-inset-bottom)); background: #F3F7F9; color: #173B50; }
button::after { border: 0; }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; padding: 34rpx 32rpx; background: linear-gradient(120deg,#E8F4FA,#fff); border-radius: 20rpx; border-left: 6rpx solid #237BA8; }
.eyebrow { display: block; color: #237BA8; font-size: 28rpx; font-weight: 600; }
.heading-title { display: block; font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.heading-desc { display: block; color: #58717E; font-size: 28rpx; margin-top: 6rpx; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 12rpx 0 20rpx; color: #526B78; font-size: 28rpx; }
.toolbar button { display: flex; align-items: center; justify-content: center; margin: 0; color: #145B94; background: #E8F4FA; font-size: 28rpx; padding: 10rpx 18rpx; min-height: 88rpx; border-radius: 12rpx; }
.filter-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.filters { display: inline-flex; gap: 12rpx; padding-bottom: 8rpx; }
.filter { box-sizing: border-box; padding: 0 24rpx; min-height: 88rpx; margin: 0; display: flex; align-items: center; border-radius: 12rpx; border: 1rpx solid #C7DCE7; background: #fff; color: #3E5B6B; font-size: 28rpx; }
.filter.active { background: #1769A6; color: #fff; border-color: #1769A6; font-weight: 700; }
.filter:active { background: #E8F4FA; }
.message { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; width: 100%; min-height: 140rpx; line-height: 1.5; text-align: left; margin: 0 0 14rpx; padding: 24rpx; background: #fff; border: 1rpx solid #DFE9EF; border-radius: 16rpx; }
.message.unread { border-left: 6rpx solid #237BA8; }
.message:active { background: #F0F7FA; }
.icon-box { width: 74rpx; height: 74rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #ECF5F9; }
.message-body { flex: 1; min-width: 0; }
.message-line { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.description { color: #173B50; font-size: 30rpx; font-weight: 700; }
.dot { width: 14rpx; height: 14rpx; flex: none; border-radius: 50%; background: #D6654D; }
.article-title, .excerpt, .date { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.article-title { color: #526B78; font-size: 28rpx; margin-top: 6rpx; }
.excerpt { color: #657C87; font-size: 28rpx; margin-top: 6rpx; }
.date { color: #526B78; font-size: 28rpx; margin-top: 10rpx; }
.state-card { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 30rpx; background: #fff; border-radius: 18rpx; color: #526B78; font-size: 30rpx; text-align: center; }
.state-card .hint { font-size: 28rpx; line-height: 1.6; }
.state-card button { display: flex; align-items: center; justify-content: center; min-height: 92rpx; background: #1769A6; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 12rpx 32rpx; margin-top: 12rpx; }
.list-bottom { display: block; text-align: center; color: #607884; font-size: 28rpx; padding: 28rpx; }
.load-more { min-height: 92rpx; margin: 8rpx 0; border: 1rpx solid #C7DCE7; border-radius: 12rpx; background: #fff; color: #145B94; font-weight: 600; }
