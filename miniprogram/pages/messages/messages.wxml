<view class="messages-page">
  <view class="page-heading"><view><text class="eyebrow">互动消息</text><text class="heading-title">消息中心</text><text class="heading-desc">点赞、评论和收藏记录都在这里</text></view><ui-icon name="bell" size="60" tone="active" /></view>
  <view wx:if="{{!loggedIn}}" class="state-card"><text>登录后查看你的互动消息</text><button bindtap="goLogin">去登录</button></view>
  <block wx:else>
    <view class="toolbar"><text>{{unreadCount ? '有 ' + unreadCount + ' 条未读消息' : '消息已读完'}}</text><button wx:if="{{unreadCount}}" bindtap="markAllRead" disabled="{{markingAll}}">全部已读</button></view>
    <scroll-view scroll-x="true" class="filter-scroll"><view class="filters"><button wx:for="{{filters}}" wx:key="id" class="filter {{filter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter">{{item.label}}</button></view></scroll-view>
    <view class="message-list">
      <button class="message {{item.read ? '' : 'unread'}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openMessage">
        <view class="icon-box"><ui-icon name="{{item.icon}}" size="42" tone="active" /></view>
        <view class="message-body"><view class="message-line"><text class="description">{{item.description}}</text><text class="dot" wx:if="{{!item.read}}"></text></view><text class="article-title">《{{item.articleTitle}}》</text><text class="excerpt" wx:if="{{item.content}}">{{item.content}}</text><text class="date">{{item.date}}</text></view>
        <ui-icon name="right" size="26" tone="muted" />
      </button>
    </view>
    <view class="state-card" wx:if="{{!loading && error}}"><text>{{error}}</text><button bindtap="refresh">重新加载</button></view>
    <view class="state-card" wx:elif="{{!loading && !items.length}}"><ui-icon name="inbox" tone="muted" size="68" /><text>这里暂时没有消息</text><text class="hint">浏览科普文章并参与交流，互动会在这里出现</text></view>
    <view class="list-bottom" wx:if="{{loading}}">消息加载中…</view>
    <button class="list-bottom load-more" wx:if="{{hasMore && !loading}}" bindtap="loadMore">查看更多消息</button>
  </block>
</view>
