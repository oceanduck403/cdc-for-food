<view class="container">

  <!-- 顶部状态卡 -->
  <view class="status-card card">
    <view class="status-left">
      <ui-icon name="camera" size="42" />
      <view>
        <text class="status-title">拍照识膳食</text>
        <text class="status-sub">AI 智能营养分析</text>
      </view>
    </view>
    <view class="quota-badge" style="{{remaining === 0 ? 'background:#FEE2E2;color:#B42318' : 'background:#EAF3FD;color:#0D4E89'}}">
      {{remaining === 0 ? '今日已用完' : '剩余 ' + remaining + ' 次'}}
    </view>
  </view>

  <!-- 图片上传区 -->
  <view class="upload-wrap card" bindtap="chooseImage">
    <block wx:if="{{imagePath}}">
      <image src="{{imagePath}}" mode="aspectFill" class="preview-img"/>
      <view class="preview-overlay">
        <text class="preview-tip">点击重新选择图片</text>
      </view>
    </block>
    <block wx:else>
      <view class="upload-zone">
        <ui-icon name="camera" size="60" />
        <text class="upload-text">点击拍照或从相册选择</text>
        <text class="upload-hint">支持 JPG / PNG / WEBP</text>
      </view>
    </block>
  </view>

  <!-- 分析按钮 -->
  <button class="btn-primary analyze-btn"
          bindtap="analyze"
          disabled="{{!imagePath || analyzing || remaining === 0}}">
    <block wx:if="{{analyzing}}">
      <text class="spinner"/>分析中…
    </block>
    <block wx:elif="{{remaining === 0}}">
      今日次数已用完
    </block>
    <block wx:else>
      开始分析
    </block>
  </button>

  <!-- 错误提示 -->
  <view class="error-box" wx:if="{{errorMsg}}">
    <view><ui-icon name="info" size="26" /> {{errorMsg}}</view>
  </view>

  <!-- 分析结果 -->
  <block wx:if="{{result}}">

    <!-- 结果摘要 -->
    <view class="result-summary card">
      <view class="summary-header">
        <text class="result-badge">AI 分析结果</text>
        <text class="result-count">共 {{result.items.length}} 种食材</text>
      </view>
      <view class="summary-total">
        <text class="total-kcal">{{result.totalKcal}}</text>
        <text class="total-unit">kcal</text>
      </view>
      <view class="total-breakdown">
        <view class="breakdown-item">
          <text class="bd-val text-warning">{{result.totalProtein}}g</text>
          <text class="bd-label">蛋白质</text>
        </view>
        <view class="breakdown-item">
          <text class="bd-val text-warning">{{result.totalFat}}g</text>
          <text class="bd-label">脂肪</text>
        </view>
        <view class="breakdown-item">
          <text class="bd-val text-warning">{{result.totalCarbs}}g</text>
          <text class="bd-label">碳水</text>
        </view>
        <view class="breakdown-item">
          <text class="bd-val text-warning">{{result.totalSodium}}mg</text>
          <text class="bd-label">钠</text>
        </view>
      </view>
    </view>

    <!-- 食材明细 -->
    <view class="section-title">食材明细</view>
    <view class="item-list">
      <view class="item-card card" wx:for="{{result.items}}" wx:key="name">
        <view class="item-top">
          <text class="item-name">{{item.name}}</text>
          <text class="item-kcal">{{item.kcal}} kcal</text>
        </view>
        <view class="bar">
          <view class="bar-fill" style="width: {{item.percent}}%"/>
        </view>
        <view class="item-meta">
          <text>约 {{item.grams}} g</text>
          <text class="text-muted">蛋白 {{item.protein}}g · 脂肪 {{item.fat}}g · 碳水 {{item.carbs}}g</text>
        </view>
      </view>
    </view>

    <!-- 报告按钮 -->
    <button class="btn-ghost" bindtap="viewReport">查看完整膳食报告</button>

  </block>

</view>
