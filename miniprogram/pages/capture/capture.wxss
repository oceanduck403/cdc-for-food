/* ── 状态卡 ─────────────────────────────────────────────────────────── */

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-icon {
  font-size: 40rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  display: block;
}

.status-sub {
  font-size: 23rpx;
  color: var(--text-muted, #9CA3AF);
  display: block;
}

.quota-badge {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* ── 上传区 ─────────────────────────────────────────────────────────── */

.upload-wrap {
  padding: 0;
  overflow: hidden;
  border-radius: var(--radius-lg, 24rpx);
  min-height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border, #E5E7EB);
  background: var(--bg-white, #FFFFFF);
}

.upload-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 12rpx;
}

.upload-icon {
  font-size: 80rpx;
  display: block;
}

.upload-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary, #111827);
}

.upload-hint {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.preview-img {
  width: 100%;
  height: 380rpx;
  display: block;
  border-radius: var(--radius-lg, 24rpx);
}

.preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 380rpx;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg, 24rpx);
}

.preview-tip {
  color: #FFFFFF;
  font-size: 26rpx;
  background: rgba(0,0,0,0.5);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.upload-wrap {
  position: relative;
}

/* ── 分析按钮 ──────────────────────────────────────────────────────── */

.analyze-btn {
  margin-top: 24rpx;
  position: relative;
}

.spinner {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255,255,255,0.4);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 8rpx;
  vertical-align: middle;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── 错误框 ───────────────────────────────────────────────────────── */

.error-box {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--danger-light, #FEE2E2);
  border-radius: var(--radius-md, 16rpx);
  color: var(--danger, #EF4444);
  font-size: 26rpx;
}

/* ── 结果摘要 ─────────────────────────────────────────────────────── */

.result-summary {
  border-top: 6rpx solid var(--brand, #0F8A65);
  padding-top: 24rpx;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-badge {
  background: var(--brand-light, #E8F5F0);
  color: var(--brand, #0F8A65);
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.result-count {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

.summary-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.total-kcal {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--brand, #0F8A65);
  line-height: 1;
}

.total-unit {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
}

.total-breakdown {
  display: flex;
  border-top: 1rpx solid var(--border, #E5E7EB);
  padding-top: 20rpx;
  gap: 0;
}

.breakdown-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bd-val {
  font-size: 30rpx;
  font-weight: 700;
}

.bd-label {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 4rpx;
}

/* ── 食材明细 ─────────────────────────────────────────────────────── */

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  margin: 28rpx 0 16rpx;
  padding-left: 4rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.item-card {
  padding: 24rpx;
  margin-bottom: 0;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
}

.item-kcal {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand, #0F8A65);
}

.item-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #4B5563);
}

/* ── 次数用完提示 ──────────────────────────────────────────────────── */

.limit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.limit-card {
  width: 100%;
  max-width: 560rpx;
  padding: 48rpx;
  text-align: center;
  margin: 0;
}

.limit-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.limit-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary, #111827);
  margin-bottom: 12rpx;
}

.limit-desc {
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  margin-bottom: 32rpx;
}

.limit-actions {
  display: flex;
  gap: 20rpx;
}

.btn-outline {
  flex: 1;
  padding: 24rpx;
  border: 2rpx solid var(--border, #E5E7EB);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-secondary, #4B5563);
  text-align: center;
}

.btn-primary {
  flex: 1;
  padding: 24rpx;
  background: var(--brand, #0F8A65);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
