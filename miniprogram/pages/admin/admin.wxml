<view class="container">
  <view class="top-bar">
    <view class="admin-info">
      <view class="avatar"><ui-icon name="setting" size="42" tone="white" /></view>
      <view class="info">
        <text class="name">{{profile.nickname || profile.username || '管理员'}}</text>
        <text class="meta">科普内容管理</text>
      </view>
    </view>
    <view class="account-actions">
      <view class="account-password-btn" bindtap="openChangeAccount"><text>账号设置</text></view>
      <view class="logout-btn" bindtap="logout"><text>退出</text></view>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab {{tab === 'dashboard' ? 'active' : ''}}" data-tab="dashboard" bindtap="switchTab">
      <ui-icon name="chart" size="36" tone="{{tab === 'dashboard' ? 'active' : 'muted'}}" />
      <text class="tab-label">概览</text>
    </view>
    <view class="tab {{tab === 'patients' ? 'active' : ''}}" data-tab="patients" bindtap="switchTab">
      <ui-icon name="team" size="36" tone="{{tab === 'patients' ? 'active' : 'muted'}}" />
      <text class="tab-label">用户</text>
    </view>
    <view class="tab {{tab === 'survey' ? 'active' : ''}}" data-tab="survey" bindtap="switchTab">
      <ui-icon name="survey" size="36" tone="{{tab === 'survey' ? 'active' : 'muted'}}" />
      <text class="tab-label">健康评估</text>
    </view>
  </view>

  <scroll-view class="content" scroll-y>
    <block wx:if="{{tab === 'dashboard'}}">
      <view class="stats-grid single-stat-grid">
        <view class="stat-card stat-blue">
          <text class="stat-num">{{stats.total_patients || 0}}</text>
          <text class="stat-label">注册用户</text>
        </view>
      </view>
      <view class="info-card">
        <view class="info-title"><ui-icon name="info" size="30" /> 首发科普版</view>
        <view class="info-text">
          <text>· 管理用户与健康评估模板</text>
          <text>· 科普素材由运营方统一提供，普通用户不能上传文章</text>
          <text>· AI 内容仅用于营养与食品安全科普，不提供诊疗服务</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{tab === 'patients'}}">
      <view class="toolbar">
        <view class="search-input-wrap">
          <input class="search-input" placeholder="按 ID、昵称或手机号搜索" value="{{patientKeyword}}" bindinput="onPatientKwInput" bindconfirm="reloadPatients" />
        </view>
      </view>
      <view class="patient-list">
        <view wx:if="{{patients.length === 0}}" class="empty"><text>暂无注册用户</text></view>
        <view wx:for="{{patients}}" wx:key="id" class="patient-row">
          <view class="patient-row-avatar">{{item.real_name ? item.real_name[0] : (item.nickname ? item.nickname[0] : '用')}}</view>
          <view class="patient-row-info">
            <view><text class="patient-row-name">{{item.real_name || item.nickname || '用户' + item.id}}</text><text class="patient-row-id">ID:{{item.id}}</text></view>
            <view class="patient-row-meta">
              <view wx:if="{{item.phone}}"><ui-icon name="mobile" size="24" /> {{item.phone}}</view>
              <text wx:if="{{item.age}}">{{item.age}}岁</text><text wx:if="{{item.sex}}">{{item.sex}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{tab === 'survey'}}">
      <view class="survey-sub-tab-bar">
        <view class="survey-sub-tab {{surveySub === 'templates' ? 'active' : ''}}" data-sub="templates" bindtap="switchSurveySub"><text>模板管理</text></view>
        <view class="survey-sub-tab {{surveySub === 'responses' ? 'active' : ''}}" data-sub="responses" bindtap="switchSurveySub"><text>提交记录</text></view>
      </view>

      <block wx:if="{{surveySub === 'templates'}}">
        <view class="toolbar">
          <view class="search-input-wrap" style="flex:1"><input class="search-input" placeholder="搜索模板名称" value="{{surveyKw}}" bindinput="onSurveyKwInput" /></view>
          <view class="btn-add" bindtap="openAddTemplate"><ui-icon name="plus" size="26" tone="white" /><text>新增模板</text></view>
        </view>
        <view wx:if="{{filteredTemplates.length === 0}}" class="empty"><text>暂无健康评估模板</text></view>
        <view wx:for="{{filteredTemplates}}" wx:key="id" class="template-card">
          <view class="template-header">
            <view class="template-title-row"><text class="template-name">{{item.name}}</text><text class="tag {{item.is_active ? 'tag-green' : 'tag-gray'}}">{{item.is_active ? '已启用' : '已停用'}}</text></view>
            <text class="template-desc">{{item.description}}</text><text class="template-meta">分类：{{item.category}} · 题目：{{item.questions.length}} 道</text>
          </view>
          <view class="template-actions">
            <view class="btn-mini" bindtap="viewTemplate" data-id="{{item.id}}"><text>查看题目</text></view>
            <view class="btn-mini" bindtap="toggleTemplateActive" data-id="{{item.id}}" data-current="{{item.is_active}}"><text>{{item.is_active ? '停用' : '启用'}}</text></view>
            <view class="btn-mini" bindtap="openEditTemplate" data-id="{{item.id}}"><text>编辑</text></view>
          </view>
        </view>
      </block>

      <block wx:if="{{surveySub === 'responses'}}">
        <view class="toolbar">
          <view class="filter-wrap"><picker mode="selector" range="{{surveyTypeOptions}}" range-key="label" bindchange="onSurveyTypeChange"><view class="picker"><text>{{selectedSurveyTypeLabel || '全部类型'}}</text><text class="picker-arrow">▼</text></view></picker></view>
          <view class="search-input-wrap" style="flex:1"><input class="search-input" placeholder="搜索姓名或手机号" value="{{responseKw}}" bindinput="onResponseKwInput" bindconfirm="_loadResponses" /></view>
        </view>
        <view wx:if="{{surveyResponses.length === 0}}" class="empty"><text>暂无提交记录</text></view>
        <view wx:for="{{surveyResponses}}" wx:key="id" class="response-card">
          <view class="response-header"><text class="response-name">{{item.user_name || '匿名'}}</text><text class="response-time">{{item.submitted_at || item.created_at}}</text></view>
          <view class="response-meta"><text>手机：{{item.user_phone || '-'}}</text><text>类型：{{item.template_type}}</text></view>
          <view class="response-actions"><view class="btn-mini" bindtap="viewResponseDetail" data-id="{{item.id}}"><text>查看详情</text></view></view>
        </view>
      </block>
    </block>
  </scroll-view>

  <view class="modal" wx:if="{{showChangeAccount}}" bindtap="closeChangeAccount">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title"><ui-icon name="key" size="32" /> 修改账号密码</view><view class="account-name">当前账号：{{profile.username}}</view>
      <view class="form-row"><text class="form-label">登录账号</text><input class="form-input" placeholder="3至64位英文字母、数字或下划线" value="{{accountForm.username}}" bindinput="onAccountFieldInput" data-field="username" /></view>
      <view class="form-row"><text class="form-label">原密码 *</text><input class="form-input" password="true" placeholder="修改账号或密码都需验证" value="{{accountForm.current}}" bindinput="onAccountFieldInput" data-field="current" /></view>
      <view class="form-row"><text class="form-label">新密码（不修改可留空）</text><input class="form-input" password="true" placeholder="至少12位，含大小写、数字和符号" value="{{accountForm.next}}" bindinput="onAccountFieldInput" data-field="next" /></view>
      <view class="form-row"><text class="form-label">确认新密码</text><input class="form-input" password="true" placeholder="再次输入新密码" value="{{accountForm.confirm}}" bindinput="onAccountFieldInput" data-field="confirm" /></view>
      <view class="modal-actions"><view class="btn-cancel" bindtap="closeChangeAccount"><text>取消</text></view><view class="btn-confirm" bindtap="submitChangeAccount"><text>保存并重新登录</text></view></view>
    </view>
  </view>

  <view class="modal" wx:if="{{showTemplateDetail}}" bindtap="closeTemplateDetail">
    <view class="modal-content modal-lg" catchtap="noop">
      <view class="modal-title"><ui-icon name="survey" size="32" /> {{templateDetail.name}}</view><view class="info-text" style="margin-bottom:16rpx"><text>{{templateDetail.description}}</text></view>
      <view class="question-list-admin"><view class="question-admin-item" wx:for="{{templateDetail.questions}}" wx:key="id"><view class="q-admin-title">{{index + 1}}. {{item.title}}<text class="q-type-tag">{{item.type === 'radio' ? '单选' : item.type === 'checkbox' ? '多选' : '输入'}}</text></view><view class="q-admin-options" wx:if="{{item.options && item.options.length > 0}}"><text wx:for="{{item.options}}" wx:for-item="opt" wx:key="index">· {{opt}}\n</text></view></view></view>
      <view class="modal-actions"><view class="btn-cancel full" bindtap="closeTemplateDetail"><text>关闭</text></view></view>
    </view>
  </view>

  <view class="modal" wx:if="{{showTemplateEdit}}" bindtap="closeTemplateEdit">
    <view class="modal-content modal-xl" catchtap="noop">
      <view class="modal-title"><ui-icon name="edit" size="32" /> {{editTemplate.id ? '编辑' : '新增'}}健康评估模板</view>
      <view class="form-row"><text class="form-label">模板名称 *</text><input class="form-input" placeholder="如：健康习惯自测" value="{{editTemplate.name}}" bindinput="onEditTemplateField" data-field="name" /></view>
      <view class="form-row"><text class="form-label">类型标识（英文唯一）*</text><input class="form-input" placeholder="如：healthy_habits" value="{{editTemplate.type}}" bindinput="onEditTemplateField" data-field="type" /></view>
      <view class="form-row"><text class="form-label">描述</text><textarea class="form-textarea" placeholder="简要描述自测用途" value="{{editTemplate.description}}" bindinput="onEditTemplateField" data-field="description"></textarea></view>
      <view class="form-row"><text class="form-label">分类</text><input class="form-input" placeholder="如：健康管理" value="{{editTemplate.category}}" bindinput="onEditTemplateField" data-field="category" /></view>
      <view class="modal-actions"><view class="btn-cancel" bindtap="closeTemplateEdit"><text>取消</text></view><view class="btn-confirm" bindtap="submitTemplateEdit"><text>保存</text></view></view>
    </view>
  </view>

  <view class="modal" wx:if="{{showResponseDetail}}" bindtap="closeResponseDetail">
    <view class="modal-content modal-xl" catchtap="noop">
      <view class="modal-title"><ui-icon name="chart" size="32" /> 健康评估详情</view>
      <view class="info-text" style="margin-bottom:16rpx"><text>姓名：{{responseDetail.user_name || '-'}}</text><text>手机：{{responseDetail.user_phone || '-'}}</text><text>提交时间：{{responseDetail.submitted_at || responseDetail.created_at}}</text><text>类型：{{responseDetail.template_type}}</text></view>
      <view class="answer-list-admin" wx:if="{{responseDetail.answers}}"><view class="answer-item" wx:for="{{responseDetail.questions}}" wx:key="id"><view class="answer-q">{{index + 1}}. {{item.title}}</view><view class="answer-a">{{responseDetail.answers[item.id] || '(未填)'}}</view></view><view class="analysis-box" wx:if="{{responseDetail.analysis}}"><view class="analysis-title">AI 科普分析</view><view class="analysis-content">{{responseDetail.analysis}}</view></view></view>
      <view class="modal-actions"><view class="btn-cancel full" bindtap="closeResponseDetail"><text>关闭</text></view></view>
    </view>
  </view>
</view>
