/* ── 整体容器（关键：允许整页滚动） ─────────────────── */
page {
  background: linear-gradient(180deg, #F2F8FF 0%, #FFFFFF 60%);
  min-height: 100vh;
}

.container {
  padding: 0 0 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 品牌区（紧凑） ─────────────────────────────────────── */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.brand-logo {
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #EAF3FD, #DCEBFA);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 138, 101, 0.20);
  margin-bottom: 16rpx;
}

.brand-emoji { font-size: 56rpx; }

.brand-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary, #111827);
  margin-bottom: 6rpx;
}

.brand-subtitle {
  font-size: 24rpx;
  color: var(--text-muted, #9CA3AF);
}

/* ── 角色切换 Tab（紧凑） ──────────────────────────── */
.role-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.role-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  transition: all 0.2s;
}

.role-tab.active {
  background: linear-gradient(135deg, #1769B2, #2D83C9);
  color: #FFFFFF;
}

.role-tab-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.role-tab-label {
  font-size: 22rpx;
  color: #6B7280;
}

.role-tab.active .role-tab-label {
  color: #FFFFFF;
  font-weight: 600;
}

/* ── 医生端功能介绍（横排三列） ───────────────────── */
.doctor-features {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.doctor-features .feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 8rpx 4rpx;
}

.doctor-features .feature-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.doctor-features .feature-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.doctor-features .feature-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  line-height: 1.3;
}

.doctor-features .feature-desc {
  font-size: 20rpx;
  color: var(--text-secondary, #4B5563);
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ── 功能介绍（紧凑：医生/管理员端横排） ─────────────────── */
.feature-list {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx;
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 8rpx 4rpx;
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.feature-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  line-height: 1.3;
}

.feature-desc {
  font-size: 20rpx;
  color: var(--text-secondary, #4B5563);
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ── 登录表单（紧凑） ───────────────────────────── */
.login-form {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.form-row {
  margin-bottom: 18rpx;
}

.form-input {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.login-btn {
  margin: 8rpx 0 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.btn-icon {
  font-size: 30rpx;
  margin-right: 8rpx;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 0 12rpx;
}

/* ── 隐私协议（紧凑） ─────────────────────────────── */
.privacy-card {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border, #E5E7EB);
  background: var(--bg-white, #FFFFFF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--brand, #1769B2);
  border-color: var(--brand, #1769B2);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.privacy-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.privacy-main {
  font-size: 24rpx;
  color: var(--text-secondary, #4B5563);
}

.privacy-link {
  font-size: 24rpx;
  color: var(--brand, #1769B2);
  font-weight: 500;
}

/* ── 页脚 ─────────────────────────────────────────────── */
.login-footer {
  text-align: center;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.login-footer text {
  font-size: 20rpx;
  color: var(--text-muted, #9CA3AF);
  line-height: 1.8;
}

/* ── 管理员入口链接 ──────────────────────────────── */
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  margin: 0 24rpx 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: 1rpx dashed #D1D5DB;
}

.admin-entry-icon {
  font-size: 26rpx;
  color: #9CA3AF;
}

.admin-entry-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.role-tab ui-icon { margin-bottom: 4rpx; }
.feature-item ui-icon { margin-bottom: 10rpx; }
.login-btn ui-icon { margin-right: 8rpx; }

/* 适老阅读：让主操作、说明和表单在常见手机宽度下清晰可点。 */
.brand-title { font-size: 40rpx; }
.brand-subtitle { font-size: 28rpx; color: #4B5D70; }
.role-tab { min-height: 88rpx; justify-content: center; }
.role-tab-label { font-size: 28rpx; }
.feature-name, .doctor-features .feature-name { font-size: 28rpx; }
.feature-desc, .doctor-features .feature-desc { font-size: 24rpx; color: #4B5D70; }
.form-input { height: 96rpx; line-height: 96rpx; font-size: 32rpx; }
.login-btn { height: 100rpx; line-height: 100rpx; font-size: 34rpx; }
.privacy-main, .privacy-link { font-size: 28rpx; }
.hint { font-size: 26rpx; color: #4B5D70; }
.login-footer text { font-size: 24rpx; color: #4B5D70; }
.admin-entry { min-height: 88rpx; box-sizing: border-box; }
.admin-entry-text { font-size: 28rpx; color: #34516D; }

/* Bigger labels, contrast and tap areas for senior readers. */
page { background: linear-gradient(180deg, #eaf5fa 0%, #fff 62%); }
.brand-title { font-size: 40rpx; color: #193f54; }
.brand-subtitle { font-size: 27rpx; color: #516b78; }
.brand-logo { background: #e5f3f9; box-shadow: 0 8rpx 24rpx rgba(23,104,140,.16); }
.role-tab { min-height: 86rpx; }
.role-tab.active { background: #1769A6; }
.role-tab-label { font-size: 28rpx; color: #4b6674; }
.feature-name, .doctor-features .feature-name { font-size: 27rpx; }
.feature-desc, .doctor-features .feature-desc { font-size: 24rpx; line-height: 1.55; color: #506a76; }
.form-input { height: 96rpx; line-height: 96rpx; font-size: 30rpx; border-color: #cbdce4; }
.login-btn { min-height: 96rpx; line-height: 96rpx; font-size: 31rpx; }
.hint, .privacy-main, .privacy-link, .admin-entry-text { font-size: 26rpx; line-height: 1.6; }
.privacy-link { color: #1769A6; }
.login-footer text { font-size: 23rpx; color: #536d79; }
