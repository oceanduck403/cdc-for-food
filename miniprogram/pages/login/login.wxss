/* ── 品牌区 ─────────────────────────────────────────────────────────── */

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 48rpx;
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #E8F5F0, #D1FAE5);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 138, 101, 0.20);
  margin-bottom: 24rpx;
}

.brand-emoji { font-size: 72rpx; }

.brand-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary, #111827);
  margin-bottom: 10rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: var(--text-muted, #9CA3AF);
}

/* ── 功能介绍 ─────────────────────────────────────────────────────── */

.feature-list {
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  gap: 20rpx;
}

.feature-item + .feature-item {
  border-top: 1rpx solid var(--border, #E5E7EB);
}

.feature-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.feature-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #111827);
  line-height: 1.3;
}

.feature-desc {
  font-size: 25rpx;
  color: var(--text-secondary, #4B5563);
  margin-top: 4rpx;
  line-height: 1.5;
}

/* ── 隐私协议 ─────────────────────────────────────────────────────── */

.privacy-card {
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--border, #E5E7EB);
  background: var(--bg-white, #FFFFFF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--brand, #0F8A65);
  border-color: var(--brand, #0F8A65);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.privacy-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.privacy-main {
  font-size: 26rpx;
  color: var(--text-secondary, #4B5563);
}

.privacy-link {
  font-size: 26rpx;
  color: var(--brand, #0F8A65);
  font-weight: 500;
}

/* ── 登录按钮 ─────────────────────────────────────────────────────── */

.login-btn {
  margin-bottom: 24rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* ── 页脚 ─────────────────────────────────────────────────────────── */

.login-footer {
  text-align: center;
}

.login-footer text {
  font-size: 22rpx;
  color: var(--text-muted, #9CA3AF);
  line-height: 1.9;
}
