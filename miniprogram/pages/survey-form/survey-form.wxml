<view class="container">
  <view class="empty-state" wx:if="{{loading}}">
    <text class="empty-text">正在加载问卷…</text>
  </view>
  <view class="empty-state" wx:elif="{{loadError}}">
    <text class="empty-text">问卷暂时无法显示</text>
    <text class="empty-hint">{{loadError}}</text>
    <button class="btn-primary retry-button" bindtap="retryLoad">重新加载</button>
    <button class="btn-secondary retry-button" bindtap="goBack">返回列表</button>
  </view>
  <!-- 分析结果页面 -->
  <block wx:elif="{{mode === 'analyze' && analysisResult}}">
    <view class="result-card card">
      <view class="result-header">
        <ui-icon name="robot" size="42" />
        <text class="result-title">AI 智能分析报告</text>
      </view>
      <view class="result-body">
        <text class="result-content">{{analysisResult.reply}}</text>
      </view>
    </view>
    <view class="action-buttons">
      <button class="btn-secondary" bindtap="goBack">返回问卷列表</button>
    </view>
  </block>

  <!-- 问卷填写页面 -->
  <block wx:else>
    <!-- 问卷标题 -->
    <view class="survey-header">
      <text class="draft-hint" wx:if="{{draftSaved && mode === 'edit' && !submitted}}">草稿已保存在本机，可稍后继续填写</text>
      <text class="survey-title">{{surveyTitle}}</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{(currentStep + 1) / totalSteps * 100}}%"></view>
      </view>
      <text class="progress-text">第 {{currentStep + 1}} / {{totalSteps}} 部分</text>
    </view>

    <!-- 题目容器 - 动态渲染当前步骤题目 -->
    <view class="questions-container">
      <block wx:for="{{currentQuestions}}" wx:for-item="question" wx:key="id">
        <view class="question-card">
          <view class="question-title">
            <text class="q-num">{{question.number}}.</text>
            <text>{{question.title}}</text>
          </view>

          <!-- 单选 -->
          <view class="options-list" wx:if="{{question.type === 'radio'}}">
            <view
              class="option-item {{option.selected ? 'selected' : ''}}"
              wx:for="{{question.choices}}"
              wx:for-item="option"
              wx:key="value"
              data-id="{{question.id}}"
              data-value="{{option.value}}"
              bindtap="onRadioChange"
            >
              <view class="option-radio">
                <view class="radio-inner" wx:if="{{option.selected}}"></view>
              </view>
              <text>{{option.value}}</text>
            </view>
          </view>

          <!-- 多选 -->
          <view class="options-list" wx:if="{{question.type === 'checkbox'}}">
            <checkbox-group data-id="{{question.id}}" bindchange="onCheckboxChange">
              <label
                class="option-item {{option.selected ? 'selected' : ''}}"
                wx:for="{{question.choices}}"
                wx:for-item="option"
                wx:key="value"
              >
                <checkbox value="{{option.value}}" checked="{{option.selected}}" disabled="{{mode === 'view' || submitted}}"/>
                <text>{{option.value}}</text>
              </label>
            </checkbox-group>
          </view>

          <!-- 输入 -->
          <view class="input-wrapper" wx:if="{{question.type === 'input'}}">
            <input
              class="text-input"
              type="{{question.inputType === 'number' ? 'number' : 'text'}}"
              placeholder="{{question.placeholder || '请输入'}}"
              value="{{answers[question.id] || ''}}"
              data-id="{{question.id}}"
              bindinput="onInputChange"
              disabled="{{mode === 'view' || submitted}}"
            />
          </view>

          <!-- 多行文本 -->
          <view class="input-wrapper" wx:if="{{question.type === 'textarea'}}">
            <textarea
              class="text-area"
              placeholder="{{question.placeholder || '请输入'}}"
              value="{{answers[question.id] || ''}}"
              data-id="{{question.id}}"
              bindinput="onInputChange"
              disabled="{{mode === 'view' || submitted}}"
              auto-height
              maxlength="-1"
            />
          </view>
          <view class="input-wrapper" wx:if="{{question.type === 'date'}}">
            <picker mode="date" value="{{answers[question.id] || ''}}" data-id="{{question.id}}" bindchange="onInputChange" disabled="{{mode === 'view' || submitted}}">
              <view class="text-input date-input">{{answers[question.id] || question.placeholder || '请选择日期'}}<ui-icon name="right" size="26" tone="muted" /></view>
            </picker>
            <button wx:if="{{answers[question.id] && mode !== 'view' && !submitted}}" class="clear-date" data-id="{{question.id}}" bindtap="clearDate">清除日期</button>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-bar" wx:if="{{totalSteps > 0}}">
      <button class="btn-prev" bindtap="prevStep" wx:if="{{currentStep > 0}}">上一步</button>
      <button class="btn-next {{currentStep === 0 ? 'full' : ''}}" bindtap="nextStep" wx:if="{{currentStep < totalSteps - 1}}">下一步</button>
      <button class="btn-submit {{currentStep === 0 ? 'full' : ''}}" bindtap="submitSurvey" loading="{{submitting}}" disabled="{{submitting}}" wx:if="{{currentStep === totalSteps - 1 && mode !== 'view' && !submitted}}">{{surveyType === 'weight_visit_registration' ? '提交登记' : '提交问卷'}}</button>
      <button class="btn-next" bindtap="goBack" wx:if="{{currentStep === totalSteps - 1 && (mode === 'view' || submitted)}}">返回列表</button>
    </view>
  </block>
</view>
