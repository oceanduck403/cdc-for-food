/* pages/survey-form/survey-form.wxss */

/* 分析结果页面 */
.result-card {
  background: #fff;
  border: 1rpx solid #dce7ef;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.result-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.result-header ui-icon { margin-right: 16rpx; }

.result-title {
  font-size: 35rpx;
  font-weight: 700;
  color: #173b50;
}

.result-body {
  background: #f4f9fc;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.result-content {
  font-size: 30rpx;
  color: #263f4e;
  line-height: 1.8;
  white-space: pre-wrap;
}

.result-footer {
  text-align: right;
}

.result-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-secondary, .btn-primary {
  flex: 1;
  min-height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}

.btn-secondary {
  background: #eaf2f7;
  color: #145b94;
}

.btn-primary {
  background: linear-gradient(135deg, #1769B2, #2D83C9);
  color: #fff;
}

.container {
  box-sizing: border-box;
  padding: 28rpx;
  background: #F3F7F9;
  min-height: 100vh;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  color: #173b50;
}

/* 问卷头部 */
.survey-header {
  background: #fff;
  border: 1rpx solid #dce7ef;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.survey-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #173b50;
  margin-bottom: 24rpx;
  text-align: left;
  line-height: 1.45;
}

.progress-bar {
  height: 8rpx;
  background: #E5E7EB;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1769B2, #2D83C9);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #496675;
  text-align: left;
}

/* 题目卡片 */
.questions-container {
  margin-bottom: 30rpx;
}

.question-card {
  background: #fff;
  border: 1rpx solid #dce7ef;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.question-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #173b50;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.q-num {
  color: #1769B2;
  font-weight: 600;
  margin-right: 8rpx;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
}

.option-item {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 22rpx 24rpx;
  background: #f7fafc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e2ebf0;
  transition: all 0.2s;
}

.option-item.selected {
  background: #edf6fc;
  border-color: #1769B2;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #D1D5DB;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-item.selected .option-radio {
  border-color: #1769B2;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  background: #1769B2;
  border-radius: 50%;
}

.option-item text {
  font-size: 30rpx;
  color: #263f4e;
  line-height: 1.5;
}

/* 输入框 */
.input-wrapper {
  margin-top: 16rpx;
}

.text-input {
  box-sizing: border-box;
  height: 96rpx;
  width: 100%;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #cbdce6;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #173b50;
}

.text-input:focus {
  border-color: #1769B2;
}

.text-area {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #cbdce6;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #173b50;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background: #fff;
  border: 1rpx solid #dce7ef;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 33rpx;
  color: #173b50;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 28rpx;
  line-height: 1.6;
  color: #526b78;
  text-align: center;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 18rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(23, 72, 100, 0.09);
}

.btn-prev, .btn-next, .btn-submit {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  margin: 0 10rpx;
}

.btn-prev {
  background: #eaf2f7;
  color: #145b94;
}

.btn-next {
  background: #1769B2;
  color: #fff;
}

.btn-submit {
  background: linear-gradient(135deg, #1769B2, #2D83C9);
  color: #fff;
}

.btn-next.full, .btn-submit.full {
  margin: 0;
}

.date-input { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.clear-date { display: flex; align-items: center; justify-content: flex-start; min-height: 88rpx; margin: 8rpx 0 0; padding: 0 18rpx; background: transparent; color: #145b94; font-size: 28rpx; text-align: left; }
.clear-date::after { border: 0; }
.retry-button { flex: none; width: 100%; margin-top: 24rpx; }
.draft-hint { display: block; padding-bottom: 20rpx; color: #145b94; font-size: 28rpx; line-height: 1.5; }
