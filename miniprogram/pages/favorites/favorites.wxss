.favorites-page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 28rpx calc(70rpx + env(safe-area-inset-bottom)); background: #F3F7F9; color: #173B50; }
button::after { border: 0; }
.hero { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; padding: 34rpx 32rpx; background: linear-gradient(120deg,#E8F4FA,#fff); border-radius: 20rpx; border-left: 6rpx solid #237BA8; }
.eyebrow { display: block; color: #237BA8; font-size: 28rpx; font-weight: 600; }
.title { display: block; font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.hint { display: block; color: #58717E; font-size: 28rpx; margin-top: 6rpx; }
.article { background: #fff; border: 1rpx solid #DFE9EF; border-radius: 18rpx; padding: 28rpx; margin-bottom: 18rpx; box-shadow: 0 4rpx 14rpx rgba(26,77,104,.04); }
.article-body { min-height: 120rpx; padding-bottom: 8rpx; }
.article-body:active { opacity: .72; }
.article-title { display: block; color: #173B50; font-size: 33rpx; font-weight: 700; line-height: 1.45; }
.summary { display: block; color: #536D79; font-size: 28rpx; line-height: 1.6; margin-top: 12rpx; }
.meta { display: block; color: #526B78; font-size: 28rpx; margin-top: 16rpx; }
.actions { display: flex; align-items: center; gap: 16rpx; border-top: 1rpx solid #E7EEF1; margin-top: 22rpx; padding-top: 18rpx; }
.actions button { display: flex; align-items: center; justify-content: center; gap: 4rpx; flex: 1; min-height: 92rpx; margin: 0; border-radius: 12rpx; background: #E8F4FA; color: #145B94; font-size: 29rpx; font-weight: 600; padding: 0 12rpx; }
.actions .remove { border: 1rpx solid #E8D7D2; background: #FFF9F7; color: #824C43; }
.state-card { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 30rpx; background: #fff; border-radius: 18rpx; color: #526B78; font-size: 30rpx; text-align: center; }
.state-card button { display: flex; align-items: center; justify-content: center; min-height: 92rpx; background: #1769A6; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 12rpx 32rpx; margin-top: 12rpx; }
.list-bottom { display: block; text-align: center; color: #607884; font-size: 28rpx; padding: 28rpx; }
.load-more { min-height: 92rpx; margin: 8rpx 0; border: 1rpx solid #C7DCE7; border-radius: 12rpx; background: #fff; color: #145B94; font-weight: 600; }
