.container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; background: #f5f8fb; }
button::after { border: 0; }
.page-header { position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; min-height: 188rpx; padding: 30rpx 34rpx; box-sizing: border-box; background: linear-gradient(115deg, #145B94, #2785B6); overflow: hidden; }
.page-header::after { content: ''; position: absolute; right: -70rpx; top: -82rpx; width: 270rpx; height: 270rpx; border: 40rpx solid rgba(255,255,255,.06); border-radius: 50%; }
.header-copy { position: relative; z-index: 1; }
.page-kicker { display: block; font-size: 28rpx; color: #cde7f1; letter-spacing: 2rpx; }
.page-title { display: block; margin: 8rpx 0; color: #fff; font-size: 42rpx; font-weight: 700; }
.page-subtitle { display: block; color: #e2f1f5; font-size: 28rpx; line-height: 1.5; }
.header-mascot { position: relative; z-index: 1; width: 94rpx; height: 94rpx; flex-shrink: 0; border-radius: 32rpx; background: #e5f9fc; box-shadow: inset 0 -8rpx 0 #bee2e7, 0 9rpx 22rpx rgba(9,54,75,.22); display: flex; align-items: center; justify-content: center; color: #236882; font-size: 36rpx; font-weight: 800; }
.usage-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 12rpx 30rpx; min-height: 96rpx; box-sizing: border-box; background: #fff; border-bottom: 1rpx solid #e0e8ec; font-size: 29rpx; color: #3f5865; }
.usage-number { font-size: 34rpx; font-weight: 700; color: #1769A6; }
.clear-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx; flex-shrink: 0; margin: 0; padding: 8rpx 16rpx; min-height: 88rpx; border-radius: 12rpx; background: #edf5f9; color: #285268; font-size: 28rpx; }
.chat-scroll { flex: 1; min-height: 0; box-sizing: border-box; padding: 24rpx 28rpx; }
.chat-list { padding-bottom: 24rpx; }
.empty-card { padding: 32rpx; border: 1rpx solid #dce9ef; border-radius: 22rpx; background: linear-gradient(135deg, #fff 15%, #e9f7fa 100%); box-shadow: 0 10rpx 28rpx rgba(32,83,107,.06); }
.empty-title { display: block; color: #1f4a60; font-size: 34rpx; font-weight: 700; }
.empty-text { display: block; margin-top: 12rpx; color: #4e6875; font-size: 28rpx; line-height: 1.7; }
.quick-title { margin: 30rpx 2rpx 16rpx; font-size: 28rpx; font-weight: 700; color: #274a5b; }
.quick-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 28rpx; }
.action-item { box-sizing: border-box; display: flex; align-items: center; gap: 10rpx; width: calc(50% - 7rpx); min-height: 96rpx; margin: 0; padding: 14rpx 18rpx; border: 1rpx solid #cbdfe9; border-radius: 15rpx; background: #fff; color: #285268; font-size: 29rpx; line-height: 1.4; text-align: left; }
.action-pressed { background: #e8f4fa; }
.msg-row { display: flex; flex-direction: column; align-items: flex-start; margin: 22rpx 0; }
.msg-row.mine { align-items: flex-end; }
.message-role { color: #526b79; font-size: 28rpx; margin: 0 8rpx 8rpx; }
.msg-bubble { box-sizing: border-box; max-width: 90%; padding: 22rpx 26rpx; border-radius: 18rpx; font-size: 30rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.bubble-user { background: #d8ebf4; color: #173c50; border-bottom-right-radius: 4rpx; }
.bubble-ai { background: #fff; color: #273e4b; border: 1rpx solid #dce8ee; border-bottom-left-radius: 4rpx; }
.msg-content { white-space: pre-wrap; }
.msg-image { display: block; width: 330rpx; margin-bottom: 14rpx; border-radius: 10rpx; }
.msg-time { margin: 7rpx 8rpx 0; color: #637984; font-size: 28rpx; }
.error { display: block; flex-shrink: 0; padding: 12rpx 28rpx; color: #8a3f28; background: #fff2ea; font-size: 28rpx; line-height: 1.5; }
.input-bar { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; padding: 16rpx 20rpx; border-top: 1rpx solid #dce6ed; background: #fff; }
.btn-image { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; flex-shrink: 0; margin: 0; padding: 0; border: 1rpx solid #ccdce4; border-radius: 14rpx; background: #f5f9fa; }
.input-field { box-sizing: border-box; flex: 1; min-width: 0; height: 96rpx; padding: 0 18rpx; border: 1rpx solid #aFCBD9; border-radius: 14rpx; background: #fff; color: #1d3e50; font-size: 30rpx; }
.btn-send { flex-shrink: 0; min-width: 104rpx; height: 96rpx; line-height: 96rpx; margin: 0; padding: 0 14rpx; border-radius: 14rpx; background: #1769A6; color: #fff; font-size: 30rpx; font-weight: 700; }
.btn-send[disabled] { background: #cbdce4; color: #5e7784; }
.disclaimer { display: block; flex-shrink: 0; padding: 0 20rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff; color: #627987; text-align: center; font-size: 28rpx; line-height: 1.6; }
.modal { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; background: rgba(9,33,47,.45); }
.modal-content { box-sizing: border-box; width: 610rpx; padding: 42rpx; border-radius: 24rpx; background: #fff; }
.modal-title { display: block; color: #1d4053; font-size: 34rpx; font-weight: 700; }
.modal-desc { display: block; margin: 18rpx 0 32rpx; color: #4c6572; font-size: 28rpx; line-height: 1.7; }
.modal-btn { width: 100%; min-height: 88rpx; line-height: 88rpx; border-radius: 14rpx; background: #1769A6; color: #fff; font-size: 30rpx; }
