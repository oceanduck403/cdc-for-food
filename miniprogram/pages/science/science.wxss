@import "../../styles/service.wxss";
/* pages/science/science.wxss */

.container {
  padding: 30rpx;
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 页面头部 */

/* AI 问答横幅 */
.ai-ask-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1769A6, #3189B9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 105, 166, 0.25);
  color: #fff;
}

.ai-ask-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.ai-ask-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.ai-ask-info {
  flex: 1;
}

.ai-ask-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.ai-ask-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

.ai-ask-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.8);
}

.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  min-height: 92rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-right: 16rpx;
}
.search-input-wrap ui-icon { margin-right: 16rpx; flex: none; }

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  font-size: 40rpx;
  color: #9CA3AF;
  padding: 0 10rpx;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.category-item {
  display: inline-flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 28rpx;
  min-height: 88rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #374151;
  transition: all 0.2s;
}

.category-item.active {
  color: #fff;
}

.cat-icon {
  margin-right: 8rpx;
}

.cat-name {
  white-space: nowrap;
}

/* 热门推荐 */
.hot-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.hot-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 40rpx;
  height: 40rpx;
  background: #FEE2E2;
  color: #EF4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.hot-info {
  flex: 1;
}

.hot-title {
  display: block;
  font-size: 31rpx;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.hot-meta {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 知识列表 */
.knowledge-list {
  margin-bottom: 30rpx;
}

.knowledge-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.knowledge-card .card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.tag text {
  font-size: 28rpx;
  font-weight: 600;
}

.card-date {
  font-size: 28rpx;
  color: #9CA3AF;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.card-summary {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.card-views {
  font-size: 28rpx;
  color: #9CA3AF;
}

.card-actions {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 5rpx;
  min-height: 88rpx;
  font-size: 28rpx;
  color: #6B7280;
  background: none;
  border: none;
  padding: 8rpx 9rpx;
  line-height: 1.4;
}
.action-btn.selected { color: #1769A6; font-weight: 600; }
.action-btn:active { background: #E9F3F9; border-radius: 12rpx; }
.retry-btn { margin-top: 22rpx; padding: 8rpx 34rpx; color: #126490; background: #EAF4FA; border-radius: 12rpx; font-size: 30rpx; }
.list-footer { display: block; text-align: center; padding: 24rpx; color: #58717E; font-size: 28rpx; }
.more-button { min-height: 88rpx; color: #126490; background: #EAF4FA; border-radius: 12rpx; }

.share-btn {
  background: none;
}

.action-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #9CA3AF;
}

.science-disclaimer {
  padding: 20rpx 16rpx 8rpx;
  text-align: center;
}

.science-disclaimer text {
  display: block;
  color: #5A727D;
  font-size: 28rpx;
  line-height: 1.8;
}

/* Readable article cards and a separate touch target for each response. */
.container.service-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.search-input-wrap { box-sizing: border-box; border: 1rpx solid #D7E4EF; }
.search-input { min-height: 50rpx; font-size: 30rpx; color: #183B58; }
.clear-icon { display: flex; align-items: center; justify-content: center; min-width: 72rpx; min-height: 72rpx; padding: 0; }
.category-item { box-sizing: border-box; border: 1rpx solid #C8DCEB; font-size: 29rpx; font-weight: 600; }
.category-item.active { border-color: #1769A6; box-shadow: 0 5rpx 12rpx rgba(23,105,166,.18); }
.hot-item { min-height: 94rpx; box-sizing: border-box; }
.hot-item:active, .knowledge-card:active { background: #F1F7FB; }
.hot-rank { background: #EAF4FB; color: #1769A6; }
.hot-title, .knowledge-card .card-title { font-size: 32rpx; line-height: 1.5; color: #183B58; }
.hot-meta, .card-date, .card-views { color: #506A80; }
.card-summary { font-size: 29rpx; line-height: 1.7; color: #405D70; }
.card-footer { display: block; border-top: 1rpx solid #E7EEF4; padding-top: 12rpx; }
.card-views { display: block; margin-bottom: 4rpx; }
.card-actions { display: flex; gap: 8rpx; }
.action-btn { box-sizing: border-box; flex: 1; min-width: 0; justify-content: center; min-height: 88rpx; padding: 8rpx 4rpx; border-radius: 12rpx; color: #405D70; }
.action-btn.selected { background: #EAF4FB; }
.action-btn:active { background: #DCEBFA; }
.empty-hint { color: #506A80; line-height: 1.65; text-align: center; }
.retry-btn, .more-button { min-height: 88rpx; box-sizing: border-box; }
