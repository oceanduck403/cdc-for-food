# 应用配置
APP_ENV=development
APP_NAME=nutrition-ai-server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 安全
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 数据库（开发期 SQLite，生产 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db
# 生产示例：postgresql+asyncpg://user:pass@host:5432/nutrition

# Redis（限流 / 缓存）
REDIS_URL=redis://localhost:6379/0

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 微信支付配置（商户号）
WECHAT_MCHID=
WECHAT_MCHKEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payment/notify

# 商用菜品识别 API（可走云函数中转）
VISION_PROVIDER=baidu
VISION_API_KEY=
VISION_API_SECRET=
VISION_DAILY_LIMIT=20

# 对象存储
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=

# 成本闸口
DAILY_ANALYSIS_LIMIT_PER_USER=20
IMAGE_MAX_BYTES=1048576