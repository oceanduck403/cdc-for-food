# 应用配置
APP_ENV=development
APP_NAME=nutrition-ai-server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 安全
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 数据库（开发期 SQLite，生产 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db
# 生产示例：postgresql+asyncpg://user:pass@host:5432/nutrition

# Redis（限流 / 缓存）
REDIS_URL=redis://localhost:6379/0

# 阿里云百炼（仅服务端保存；泄漏后必须轮换）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 首次生产部署管理员；创建并成功改密后从平台环境变量中删除
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# 商用菜品识别 API（可走云函数中转）
VISION_PROVIDER=baidu
VISION_API_KEY=
VISION_API_SECRET=
VISION_DAILY_LIMIT=20

# 对象存储
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=

# 成本闸口
DAILY_ANALYSIS_LIMIT_PER_USER=20
IMAGE_MAX_BYTES=1048576
