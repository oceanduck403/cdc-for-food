# 应用配置
APP_ENV=development
APP_NAME=nutrition-ai-server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_LOG_DIR=logs

# 安全
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 数据库（开发期 SQLite，生产 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db
# 生产示例：postgresql+asyncpg://user:pass@host:5432/nutrition

# 阿里云百炼（仅服务端保存；泄漏后必须轮换）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 首次生产部署管理员；创建并成功改密后从平台环境变量中删除
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# 人工医生预约、分配与聊天。生产默认必须保持 false；取得相应资质后再显式开启。
ENABLE_CLINICAL_SERVICES=false

# 用户头像与聊天图片（开发可用 local；CloudBase PG 生产环境推荐 cloudbase_pg）
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=uploads
MEDIA_URL_TTL_SECONDS=900
# CloudBase PG 内置云存储：仅需环境级 service_role API Key，不需要 CAM AccessKey
MEDIA_CLOUDBASE_ENV_ID=
MEDIA_CLOUDBASE_API_KEY=
MEDIA_CLOUDBASE_BUCKET=user-media
MEDIA_CLOUDBASE_TIMEOUT_SECONDS=15
# 也可选用独立私有 COS；此时配置以下字段
MEDIA_COS_SECRET_ID=
MEDIA_COS_SECRET_KEY=
MEDIA_COS_REGION=ap-chengdu
# 完整桶名必须包含 APPID，例如 nutrition-private-1250000000
MEDIA_COS_BUCKET=
# 使用临时密钥时填写；长期子账号密钥留空
MEDIA_COS_TOKEN=
MEDIA_COS_PREFIX=private/user-media

# 成本闸口
DAILY_ANALYSIS_LIMIT_PER_USER=20
IMAGE_MAX_BYTES=1048576
